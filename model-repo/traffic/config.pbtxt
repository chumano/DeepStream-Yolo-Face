name: "traffic"
platform: "tensorrt_plan"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [1, 3, 640, 640]
  }
]

output [
  {
    name: "num_dets"
    data_type: TYPE_INT32
    dims: [1, 1]
  },
  {
    name: "det_boxes"
    data_type: TYPE_FP32
    dims: [1, 100, 4]
  },
  {
    name: "det_scores"
    data_type: TYPE_FP32
    dims: [1, 100]
  },
  {
    name: "det_classes"
    data_type: TYPE_INT32
    dims: [1, 100]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
