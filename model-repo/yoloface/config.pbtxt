name: "yoloface"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [-1, 3, 640, 640] 
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [-1, 8400, 20]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

